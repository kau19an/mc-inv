---
// 404 com "resolvedor": antes de desistir, tenta entender a url que a pessoa digitou ou adivinhou
//   /inv/je/wooden-pickaxe        hífen no lugar do sublinhado
//   /inv/je/Minecraft:Wooden_Pickaxe   maiúsculas e namespace
//   /inv/je/picareta-de-madeira   nome em português (ou em inglês), com ou sem acento
//   /inv/je/wooden_pickaxe/crafting   ação que ainda não existe → abre o item
import Base from '@/layouts/Base.astro';
---

<Base title="Página não encontrada" noindex>
  <main class="grid min-h-dvh place-items-center p-6 text-center">
    <div data-not-found hidden>
      <h1 class="text-2xl font-medium">Página não encontrada</h1>
      <p class="mt-2"><a href="/inv/je" class="underline underline-offset-4">Ir para o inventário</a></p>
    </div>
    <p data-resolving class="text-neutral-400">Procurando…</p>
  </main>
</Base>

<script>
  import { ROOT } from '@/lib/gui/routes.ts';

  const normalize = (text: string) =>
    text
      .toLowerCase()
      .normalize('NFD')
      .replace(/\p{M}/gu, '')
      .replace(/^minecraft:/, '')
      .replace(/[^a-z0-9]+/g, '_')
      .replace(/^_+|_+$/g, '');

  const giveUp = () => {
    document.querySelector<HTMLElement>('[data-resolving]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-not-found]')!.hidden = false;
  };

  async function resolve(): Promise<string | null> {
    const path = window.location.pathname;
    if (!path.startsWith(`${ROOT}/`)) return null;
    let slug: string;
    try {
      slug = decodeURIComponent(path.slice(ROOT.length + 1).split('/')[0]!);
    } catch {
      return null;
    }
    const wanted = normalize(slug);
    if (!wanted) return null;

    const index = (await (await fetch('/data/mc-inv-index.json')).json()) as {
      tabs: { id: string; pt: string; en: string }[];
      items: Record<string, { pt: string; en: string }>;
    };

    // id normalizado e nomes (pt-BR e inglês) normalizados → id de verdade
    const candidates = new Map<string, string>();
    const add = (key: string, id: string) => key && !candidates.has(key) && candidates.set(key, id);
    const entries = [...index.tabs, ...Object.entries(index.items).map(([id, names]) => ({ id, ...names }))];
    for (const { id } of entries) add(normalize(id), id);
    for (const { id, pt, en } of entries) {
      add(normalize(pt), id);
      add(normalize(en), id);
    }
    const id = candidates.get(wanted);
    return id ? `${ROOT}/${id}` : null;
  }

  resolve()
    .then((target) => (target && target !== window.location.pathname ? window.location.replace(target) : giveUp()))
    .catch(giveUp);
</script>
